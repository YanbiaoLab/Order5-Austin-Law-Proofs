  have p67 (u w x y z : G) : (((x ◇ (y ◇ (x ◇ x))) ◇ (z ◇ ((y ◇ (x ◇ x)) ◇ (y ◇ (x ◇ x))))) ◇ (z ◇ (u ◇ ((((w ◇ x) ◇ (y ◇ (x ◇ x))) ◇ (z ◇ ((y ◇ (x ◇ x)) ◇ (y ◇ (x ◇ x))))) ◇ (((w ◇ x) ◇ (y ◇ (x ◇ x))) ◇ (z ◇ ((y ◇ (x ◇ x)) ◇ (y ◇ (x ◇ x))))))))) = u := by
