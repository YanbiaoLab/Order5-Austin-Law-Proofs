        exact Or.inr (Or.inr (Or.inl (⟨v2_0, v2_1, v2_2, ha, hb, hv.trans ho, congrArg sz ha, congrArg sz hb, congrArg sz (hv.trans ho), h0, h1⟩)))
      ·
        by_cases h3 : ∃ o, Rule 3 a b o
