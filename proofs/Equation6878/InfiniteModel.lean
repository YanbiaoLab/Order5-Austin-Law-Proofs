          have hv : eval a b = Classical.choose h3 := by rw [eval, dif_neg h0, dif_neg h1, dif_neg h2, dif_pos h3]
          rcases Classical.choose_spec h3 with ⟨v3_0, v3_1, ha, hb, ho⟩
          exact Or.inr (Or.inr (Or.inr (Or.inl (⟨v3_0, v3_1, ha, hb, hv.trans ho, congrArg sz ha, congrArg sz hb, congrArg sz (hv.trans ho), h0, h1, h2⟩))))
        ·
          by_cases h4 : ∃ o, Rule 4 a b o
          ·
            have hv : eval a b = Classical.choose h4 := by rw [eval, dif_neg h0, dif_neg h1, dif_neg h2, dif_neg h3, dif_pos h4]
            rcases Classical.choose_spec h4 with ⟨v4_0, ha, hb, ho⟩
            exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl (⟨v4_0, ha, hb, hv.trans ho, congrArg sz ha, congrArg sz hb, congrArg sz (hv.trans ho), h0, h1, h2, h3⟩)))))
          ·
            by_cases h5 : ∃ o, Rule 5 a b o
            ·
              have hv : eval a b = Classical.choose h5 := by rw [eval, dif_neg h0, dif_neg h1, dif_neg h2, dif_neg h3, dif_neg h4, dif_pos h5]
              rcases Classical.choose_spec h5 with ⟨v5_0, v5_1, v5_2, ha, hb, ho⟩
              exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl (⟨v5_0, v5_1, v5_2, ha, hb, hv.trans ho, congrArg sz ha, congrArg sz hb, congrArg sz (hv.trans ho), h0, h1, h2, h3, h4⟩))))))
            ·
              by_cases h6 : ∃ o, Rule 6 a b o
              ·
                have hv : eval a b = Classical.choose h6 := by rw [eval, dif_neg h0, dif_neg h1, dif_neg h2, dif_neg h3, dif_neg h4, dif_neg h5, dif_pos h6]
                rcases Classical.choose_spec h6 with ⟨v6_0, v6_1, ha, hb, ho⟩
                exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl (⟨v6_0, v6_1, ha, hb, hv.trans ho, congrArg sz ha, congrArg sz hb, congrArg sz (hv.trans ho), h0, h1, h2, h3, h4, h5⟩)))))))
