def Carrier := {t : CM // NF t}
noncomputable def op (a b : Carrier) : Carrier := ⟨eval a.val b.val, eval_nf a.property b.property⟩
noncomputable instance instMagmaNF : Magma Carrier := ⟨op⟩
theorem tower_nf (n : Nat) : NF (tower n) := by
  induction n with
  | zero => exact True.intro
  | succ n ih => exact ih
def gen (n : Nat) : Carrier := ⟨tower n, tower_nf n⟩
theorem gen_injective {n m : Nat} (h : gen n = gen m) : n = m :=
  tower_injective n m (congrArg Subtype.val h)
theorem source_holds (x y z : Carrier) : x = (op y (op y (op (op z x) (op x y)))) := by
  apply Subtype.ext
  exact source_raw x.val y.val z.val x.property y.property z.property
end CM
end submission
open submission.CM
noncomputable def submission.unifiedOriginalWitness : Goal := by
  refine ⟨Carrier, instMagmaNF, ?_, ?_⟩
  · intro x y z
    exact source_holds x y z
  · intro h
    exact Nat.zero_ne_one (gen_injective (h (gen 0) (gen 1)))
noncomputable def submission : Goal := by
  rcases submission.unifiedOriginalWitness with ⟨A, inst, holds, separates⟩
  let m : submission.NormalizedTree.Model A := submission.NormalizedTree.Model.identity (@Magma.op A inst)
  refine ⟨m.Carrier, submission.NormalizedTree.Model.instMagmaCarrier m, ?_, ?_⟩
  · intro q0 q1 q2
    apply Subtype.ext
    exact holds q0.val q1.val q2.val
  · intro h
    apply separates
    intro a b
    exact congrArg Subtype.val (h (⟨a, rfl⟩ : m.Carrier) (⟨b, rfl⟩ : m.Carrier))
