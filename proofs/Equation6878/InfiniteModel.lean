def EvalCases (a b o : CM) : Prop := (∃ v0_0 v0_1 v0_2 : CM, a = v0_0 ∧ b = (p v0_0 (p (p v0_1 v0_2) (p v0_2 v0_0))) ∧ o = v0_2 ∧ sz a = sz v0_0 ∧ sz b = sz (p v0_0 (p (p v0_1 v0_2) (p v0_2 v0_0))) ∧ sz o = sz v0_2) ∨ (∃ v1_0 v1_1 : CM, a = v1_0 ∧ b = (p v1_1 v1_0) ∧ o = (r v1_0 v1_1) ∧ sz a = sz v1_0 ∧ sz b = sz (p v1_1 v1_0) ∧ sz o = sz (r v1_0 v1_1) ∧ (¬ ∃ q, Rule 0 a b q)) ∨ (∃ v2_0 v2_1 v2_2 : CM, a = v2_0 ∧ b = (q v2_0 (q v2_1 (q v2_2 v2_0))) ∧ o = v2_2 ∧ sz a = sz v2_0 ∧ sz b = sz (q v2_0 (q v2_1 (q v2_2 v2_0))) ∧ sz o = sz v2_2 ∧ (¬ ∃ q, Rule 0 a b q) ∧ (¬ ∃ q, Rule 1 a b q)) ∨ (∃ v3_0 v3_1 : CM, a = v3_0 ∧ b = (q v3_0 (q v3_1 v3_0)) ∧ o = (q v3_0 (q v3_0 (q v3_1 v3_0))) ∧ sz a = sz v3_0 ∧ sz b = sz (q v3_0 (q v3_1 v3_0)) ∧ sz o = sz (q v3_0 (q v3_0 (q v3_1 v3_0))) ∧ (¬ ∃ q, Rule 0 a b q) ∧ (¬ ∃ q, Rule 1 a b q) ∧ (¬ ∃ q, Rule 2 a b q)) ∨ (∃ v4_0 : CM, a = v4_0 ∧ b = (q v4_0 v4_0) ∧ o = (q v4_0 (q v4_0 v4_0)) ∧ sz a = sz v4_0 ∧ sz b = sz (q v4_0 v4_0) ∧ sz o = sz (q v4_0 (q v4_0 v4_0)) ∧ (¬ ∃ q, Rule 0 a b q) ∧ (¬ ∃ q, Rule 1 a b q) ∧ (¬ ∃ q, Rule 2 a b q) ∧ (¬ ∃ q, Rule 3 a b q)) ∨ (∃ v5_0 v5_1 v5_2 : CM, a = (q v5_0 v5_1) ∧ b = (q (q v5_0 v5_1) v5_2) ∧ o = v5_0 ∧ sz a = sz (q v5_0 v5_1) ∧ sz b = sz (q (q v5_0 v5_1) v5_2) ∧ sz o = sz v5_0 ∧ (¬ ∃ q, Rule 0 a b q) ∧ (¬ ∃ q, Rule 1 a b q) ∧ (¬ ∃ q, Rule 2 a b q) ∧ (¬ ∃ q, Rule 3 a b q) ∧ (¬ ∃ q, Rule 4 a b q)) ∨ (∃ v6_0 v6_1 : CM, a = v6_0 ∧ b = v6_1 ∧ o = (q v6_0 v6_1) ∧ sz a = sz v6_0 ∧ sz b = sz v6_1 ∧ sz o = sz (q v6_0 v6_1) ∧ (¬ ∃ q, Rule 0 a b q) ∧ (¬ ∃ q, Rule 1 a b q) ∧ (¬ ∃ q, Rule 2 a b q) ∧ (¬ ∃ q, Rule 3 a b q) ∧ (¬ ∃ q, Rule 4 a b q) ∧ (¬ ∃ q, Rule 5 a b q)) ∨ (o = p a b ∧ sz o = sz (p a b) ∧ ¬ ∃ q, Code a b q)
theorem eval_cases (a b : CM) : EvalCases a b (eval a b) := by
  classical
  by_cases h0 : ∃ o, Rule 0 a b o
  ·
    have hv : eval a b = Classical.choose h0 := by rw [eval, dif_pos h0]
    rcases Classical.choose_spec h0 with ⟨v0_0, v0_1, v0_2, ha, hb, ho⟩
    exact Or.inl (⟨v0_0, v0_1, v0_2, ha, hb, hv.trans ho, congrArg sz ha, congrArg sz hb, congrArg sz (hv.trans ho)⟩)
  ·
    by_cases h1 : ∃ o, Rule 1 a b o
    ·
      have hv : eval a b = Classical.choose h1 := by rw [eval, dif_neg h0, dif_pos h1]
      rcases Classical.choose_spec h1 with ⟨v1_0, v1_1, ha, hb, ho⟩
