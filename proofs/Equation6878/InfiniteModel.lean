theorem source_raw (x y z : CM) (hx : NF x) (hy : NF y) (hz : NF z) :
    x = (eval y (eval y (eval (eval z x) (eval x y)))) := by
  classical
  generalize e0 : eval z x = H0
  have B0 : EvalCases z x H0 := by rw [← e0]; exact eval_cases z x
  have N0 : NF H0 := by rw [← e0]; exact eval_nf (hz) (hx)
  generalize e1 : eval x y = H1
  have B1 : EvalCases x y H1 := by rw [← e1]; exact eval_cases x y
  have N1 : NF H1 := by rw [← e1]; exact eval_nf (hx) (hy)
  generalize e2 : eval H0 H1 = H2
  have B2 : EvalCases H0 H1 H2 := by rw [← e2]; exact eval_cases H0 H1
  have N2 : NF H2 := by rw [← e2]; exact eval_nf (N0) (N1)
  generalize e3 : eval y H2 = H3
  have B3 : EvalCases y H2 H3 := by rw [← e3]; exact eval_cases y H2
  have N3 : NF H3 := by rw [← e3]; exact eval_nf (hy) (N2)
  generalize e4 : eval y H3 = H4
  have B4 : EvalCases y H3 H4 := by rw [← e4]; exact eval_cases y H3
  have N4 : NF H4 := by rw [← e4]; exact eval_nf (hy) (N3)
  rcases B1 with ⟨b1r0_v0_0, b1r0_v0_1, b1r0_v0_2, b1r0_a, b1r0_b, b1r0_o, b1r0_sa, b1r0_sb, b1r0_so⟩ | ⟨b1r1_v1_0, b1r1_v1_1, b1r1_a, b1r1_b, b1r1_o, b1r1_sa, b1r1_sb, b1r1_so, b1r1_miss0⟩ | ⟨b1r2_v2_0, b1r2_v2_1, b1r2_v2_2, b1r2_a, b1r2_b, b1r2_o, b1r2_sa, b1r2_sb, b1r2_so, b1r2_miss0, b1r2_miss1⟩ | ⟨b1r3_v3_0, b1r3_v3_1, b1r3_a, b1r3_b, b1r3_o, b1r3_sa, b1r3_sb, b1r3_so, b1r3_miss0, b1r3_miss1, b1r3_miss2⟩ | ⟨b1r4_v4_0, b1r4_a, b1r4_b, b1r4_o, b1r4_sa, b1r4_sb, b1r4_so, b1r4_miss0, b1r4_miss1, b1r4_miss2, b1r4_miss3⟩ | ⟨b1r5_v5_0, b1r5_v5_1, b1r5_v5_2, b1r5_a, b1r5_b, b1r5_o, b1r5_sa, b1r5_sb, b1r5_so, b1r5_miss0, b1r5_miss1, b1r5_miss2, b1r5_miss3, b1r5_miss4⟩ | ⟨b1r6_v6_0, b1r6_v6_1, b1r6_a, b1r6_b, b1r6_o, b1r6_sa, b1r6_sb, b1r6_so, b1r6_miss0, b1r6_miss1, b1r6_miss2, b1r6_miss3, b1r6_miss4, b1r6_miss5⟩ | ⟨b1raw_o, b1raw_sz, b1raw_no⟩
