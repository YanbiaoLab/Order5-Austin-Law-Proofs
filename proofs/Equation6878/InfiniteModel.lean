import Mathlib.Logic.Relation
import JudgeMagma.Magma
import JudgeProblem
import Lean.Elab.Tactic.Omega

namespace submission.NormalizedTree

/-- A common semantic interface; the carrier consists of fixed normal forms. -/
structure Model (T : Type) where
  normalize : T → T
  idempotent : ∀ t, normalize (normalize t) = normalize t
  program : T → T → T

namespace Model
variable {T : Type} (m : Model T)
def Carrier := {t : T // m.normalize t = t}
def product (a b : m.Carrier) : m.Carrier :=
  ⟨m.normalize (m.program a.val b.val), m.idempotent _⟩
instance : Magma m.Carrier := ⟨m.product⟩

def generator (g : Nat → T) (fixed : ∀ n, m.normalize (g n) = g n)
    (n : Nat) : m.Carrier := ⟨g n, fixed n⟩

theorem generators_injective (g : Nat → T)
    (fixed : ∀ n, m.normalize (g n) = g n) (inj : Function.Injective g) :
    Function.Injective (m.generator g fixed) := by
  intro n k h
  exact inj (congrArg Subtype.val h)

theorem nontrivial (g : Nat → T) (fixed : ∀ n, m.normalize (g n) = g n)
    (inj : Function.Injective g) : ¬ ∀ a b : m.Carrier, a = b := by
  intro h
  have bad : (0 : Nat) = 1 := m.generators_injective g fixed inj
    (h (m.generator g fixed 0) (m.generator g fixed 1))
  exact Nat.zero_ne_one bad

def identity (program : T → T → T) : Model T := ⟨id, fun _ => rfl, program⟩

theorem identity_product (program : T → T → T)
    (a b : (identity program).Carrier) :
    ((identity program).product a b).val = program a.val b.val := rfl
end Model

/- Rewrite reachability is distinct from a decoder's allowed-trace relation. -/
namespace Reduction
variable {T : Type} (step : T → T → Prop)
abbrev Reach := Relation.ReflTransGen step
def Normal (a : T) : Prop := ∀ b, ¬ step a b
def Join (a b : T) : Prop := ∃ c, Reach step a c ∧ Reach step b c

theorem normal_reach {a b : T} (hn : Normal step a) (h : Reach step a b) : a = b := by
  rcases h.cases_head with h | ⟨c, hac, _⟩
  · exact h
  · exact (hn c hac).elim

theorem normal_exists (rank : T → Nat)
    (decrease : ∀ {a b}, step a b → rank b < rank a) (a : T) :
    ∃ b, Reach step a b ∧ Normal step b := by
  classical
  induction a using (measure rank).wf.induction with
  | h a ih =>
    by_cases hn : Normal step a
    · exact ⟨a, .refl, hn⟩
    · have hs : ∃ b, step a b := by
        apply Classical.byContradiction
        intro h
        apply hn
        intro b hb
        exact h ⟨b, hb⟩
      rcases hs with ⟨b, hab⟩
      rcases ih b (decrease hab) with ⟨c, hbc, hc⟩
      exact ⟨c, (Relation.ReflTransGen.single hab).trans hbc, hc⟩

noncomputable def normalize (rank : T → Nat)
    (decrease : ∀ {a b}, step a b → rank b < rank a) (a : T) : T :=
  Classical.choose (normal_exists step rank decrease a)

theorem normalize_spec (rank : T → Nat)
    (decrease : ∀ {a b}, step a b → rank b < rank a) (a : T) :
    Reach step a (normalize step rank decrease a) ∧
    Normal step (normalize step rank decrease a) :=
  Classical.choose_spec (normal_exists step rank decrease a)

theorem normalize_fixed (rank : T → Nat)
    (decrease : ∀ {a b}, step a b → rank b < rank a) {a : T}
    (hn : Normal step a) : normalize step rank decrease a = a :=
  (normal_reach step hn (normalize_spec step rank decrease a).1).symm

theorem normalize_idempotent (rank : T → Nat)
    (decrease : ∀ {a b}, step a b → rank b < rank a) (a : T) :
    normalize step rank decrease (normalize step rank decrease a) = normalize step rank decrease a :=
  normalize_fixed step rank decrease (normalize_spec step rank decrease a).2

theorem join_iff_normalize_eq (rank : T → Nat)
    (decrease : ∀ {a b}, step a b → rank b < rank a)
    (confluent : ∀ {a b c}, Reach step a b → Reach step a c → Join step b c)
    (a b : T) : Join step a b ↔ normalize step rank decrease a = normalize step rank decrease b := by
  constructor
  · rintro ⟨c, hac, hbc⟩
    obtain ⟨d, had, hcd⟩ := confluent (normalize_spec step rank decrease a).1 hac
    obtain ⟨e, hbe, hce⟩ := confluent (normalize_spec step rank decrease b).1 hbc
    have ha := normal_reach step (normalize_spec step rank decrease a).2 had
    have hb := normal_reach step (normalize_spec step rank decrease b).2 hbe
    obtain ⟨f, hdf, hef⟩ := confluent hcd hce
    have haf : normalize step rank decrease a = f :=
      normal_reach step (normalize_spec step rank decrease a).2 (by simpa only [ha] using hdf)
    have hbf : normalize step rank decrease b = f :=
      normal_reach step (normalize_spec step rank decrease b).2 (by simpa only [hb] using hef)
    exact haf.trans hbf.symm
  · intro he
    exact ⟨normalize step rank decrease a, (normalize_spec step rank decrease a).1,
      by rw [he]; exact (normalize_spec step rank decrease b).1⟩

noncomputable def model (rank : T → Nat)
    (decrease : ∀ {a b}, step a b → rank b < rank a) (program : T → T → T) : Model T :=
  ⟨normalize step rank decrease, normalize_idempotent step rank decrease, program⟩
end Reduction

/-- Homomorphic evaluation transport is shared by every source equation. -/
inductive Term where
  | var : Nat → Term
  | mul : Term → Term → Term

def Term.eval {A : Type} (op : A → A → A) (env : Nat → A) : Term → A
  | .var n => env n
  | .mul l r => op (l.eval op env) (r.eval op env)

theorem eval_map {A B : Type} (opA : A → A → A) (opB : B → B → B)
    (f : A → B) (hom : ∀ a b, f (opA a b) = opB (f a) (f b))
    (env : Nat → A) (term : Term) :
    f (term.eval opA env) = term.eval opB (fun n => f (env n)) := by
  induction term with
  | var n => rfl
  | mul l r ihl ihr => simp only [Term.eval, hom, ihl, ihr]

theorem law_of_injective_hom {A B : Type} (opA : A → A → A) (opB : B → B → B)
    (f : A → B) (inj : Function.Injective f)
    (hom : ∀ a b, f (opA a b) = opB (f a) (f b)) (l r : Term)
    (h : ∀ env, l.eval opB env = r.eval opB env) :
    ∀ env, l.eval opA env = r.eval opA env := by
  intro env
  apply inj
  rw [eval_map opA opB f hom, eval_map opA opB f hom]
  exact h _

end submission.NormalizedTree
set_option maxRecDepth 10000
set_option maxHeartbeats 8000000
namespace submission
inductive CM where
  | e : CM
  | k : CM → CM
  | p : CM → CM → CM
  | q : CM → CM → CM
  | r : CM → CM → CM
deriving DecidableEq
namespace CM
def sz : CM → Nat
  | e => 0
  | k a => sz a + 1
  | p a b => sz a + sz b + 2
  | q a b => sz a + sz b + 2
  | r a b => sz a + sz b + 2
def L : CM → CM | p a _ => a | _ => e
def R : CM → CM | p _ b => b | _ => e
def U : CM → CM | k a => a | _ => e
theorem size_left (a b : CM) : sz a < sz (p a b) := by simp only [sz]; omega
theorem size_right (a b : CM) : sz b < sz (p a b) := by simp only [sz]; omega
theorem sz_lt_p_left (a b : CM) : sz a < sz (p a b) := size_left a b
theorem sz_lt_p_right (a b : CM) : sz b < sz (p a b) := size_right a b
def tower : Nat → CM
  | 0 => e
  | n + 1 => k (tower n)
theorem sz_tower (n : Nat) : sz (tower n) = n := by
  induction n with
  | zero => rfl
  | succ n ih => simp only [tower, sz, ih]
theorem tower_injective (m n : Nat) (h : tower m = tower n) : m = n := by
  have hs := congrArg sz h
  simpa only [sz_tower] using hs
def QL : CM → CM | q a _ => a | _ => e
def QR : CM → CM | q _ b => b | _ => e
def RL : CM → CM | r a _ => a | _ => e
def RR : CM → CM | r _ b => b | _ => e
theorem sz_lt_k (a : CM) : sz a < sz (k a) := by simp only [sz]; omega
theorem sz_lt_q_left (a b : CM) : sz a < sz (q a b) := by simp only [sz]; omega
theorem sz_lt_q_right (a b : CM) : sz b < sz (q a b) := by simp only [sz]; omega
theorem eq_q_congr {a b c d : CM} (ha : a = c) (hb : b = d) : q a b = q c d := by
  cases ha
  cases hb
  rfl
theorem sz_lt_r_left (a b : CM) : sz a < sz (r a b) := by simp only [sz]; omega
theorem sz_lt_r_right (a b : CM) : sz b < sz (r a b) := by simp only [sz]; omega
theorem eq_r_congr {a b c d : CM} (ha : a = c) (hb : b = d) : r a b = r c d := by
  cases ha
  cases hb
  rfl
inductive Code : CM → CM → CM → Prop
  | r0 (v0_0 v0_1 v0_2 : CM) : Code v0_0 (p v0_0 (p (p v0_1 v0_2) (p v0_2 v0_0))) v0_2
  | r1 (v1_0 v1_1 : CM) : Code v1_0 (p v1_1 v1_0) (r v1_0 v1_1)
  | r2 (v2_0 v2_1 v2_2 : CM) : Code v2_0 (q v2_0 (q v2_1 (q v2_2 v2_0))) v2_2
  | r3 (v3_0 v3_1 : CM) : Code v3_0 (q v3_0 (q v3_1 v3_0)) (q v3_0 (q v3_0 (q v3_1 v3_0)))
  | r4 (v4_0 : CM) : Code v4_0 (q v4_0 v4_0) (q v4_0 (q v4_0 v4_0))
  | r5 (v5_0 v5_1 v5_2 : CM) : Code (q v5_0 v5_1) (q (q v5_0 v5_1) v5_2) v5_0
  | r6 (v6_0 v6_1 : CM) : Code v6_0 v6_1 (q v6_0 v6_1)
def CodeShape (a b o : CM) : Prop := (∃ v0_0 v0_1 v0_2 : CM, a = v0_0 ∧ b = (p v0_0 (p (p v0_1 v0_2) (p v0_2 v0_0))) ∧ o = v0_2) ∨ (∃ v1_0 v1_1 : CM, a = v1_0 ∧ b = (p v1_1 v1_0) ∧ o = (r v1_0 v1_1)) ∨ (∃ v2_0 v2_1 v2_2 : CM, a = v2_0 ∧ b = (q v2_0 (q v2_1 (q v2_2 v2_0))) ∧ o = v2_2) ∨ (∃ v3_0 v3_1 : CM, a = v3_0 ∧ b = (q v3_0 (q v3_1 v3_0)) ∧ o = (q v3_0 (q v3_0 (q v3_1 v3_0)))) ∨ (∃ v4_0 : CM, a = v4_0 ∧ b = (q v4_0 v4_0) ∧ o = (q v4_0 (q v4_0 v4_0))) ∨ (∃ v5_0 v5_1 v5_2 : CM, a = (q v5_0 v5_1) ∧ b = (q (q v5_0 v5_1) v5_2) ∧ o = v5_0) ∨ (∃ v6_0 v6_1 : CM, a = v6_0 ∧ b = v6_1 ∧ o = (q v6_0 v6_1))
theorem code_shape {a b o : CM} (h : Code a b o) : CodeShape a b o := by
  cases h with
  | r0 => exact Or.inl (⟨_, _, _, rfl, rfl, rfl⟩)
  | r1 => exact Or.inr (Or.inl (⟨_, _, rfl, rfl, rfl⟩))
  | r2 => exact Or.inr (Or.inr (Or.inl (⟨_, _, _, rfl, rfl, rfl⟩)))
  | r3 => exact Or.inr (Or.inr (Or.inr (Or.inl (⟨_, _, rfl, rfl, rfl⟩))))
  | r4 => exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl (⟨_, rfl, rfl, rfl⟩)))))
  | r5 => exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl (⟨_, _, _, rfl, rfl, rfl⟩))))))
  | r6 => exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (⟨_, _, rfl, rfl, rfl⟩))))))
def Rule (i : Nat) (a b o : CM) : Prop :=
  match i with
  | 0 => ∃ v0_0 v0_1 v0_2 : CM, a = v0_0 ∧ b = (p v0_0 (p (p v0_1 v0_2) (p v0_2 v0_0))) ∧ o = v0_2
  | 1 => ∃ v1_0 v1_1 : CM, a = v1_0 ∧ b = (p v1_1 v1_0) ∧ o = (r v1_0 v1_1)
  | 2 => ∃ v2_0 v2_1 v2_2 : CM, a = v2_0 ∧ b = (q v2_0 (q v2_1 (q v2_2 v2_0))) ∧ o = v2_2
  | 3 => ∃ v3_0 v3_1 : CM, a = v3_0 ∧ b = (q v3_0 (q v3_1 v3_0)) ∧ o = (q v3_0 (q v3_0 (q v3_1 v3_0)))
  | 4 => ∃ v4_0 : CM, a = v4_0 ∧ b = (q v4_0 v4_0) ∧ o = (q v4_0 (q v4_0 v4_0))
  | 5 => ∃ v5_0 v5_1 v5_2 : CM, a = (q v5_0 v5_1) ∧ b = (q (q v5_0 v5_1) v5_2) ∧ o = v5_0
  | 6 => ∃ v6_0 v6_1 : CM, a = v6_0 ∧ b = v6_1 ∧ o = (q v6_0 v6_1)
  | _ => False
theorem rule0_intro (v0_0 v0_1 v0_2 : CM) : Rule 0 v0_0 (p v0_0 (p (p v0_1 v0_2) (p v0_2 v0_0))) v0_2 := ⟨v0_0, v0_1, v0_2, rfl, rfl, rfl⟩
theorem rule1_intro (v1_0 v1_1 : CM) : Rule 1 v1_0 (p v1_1 v1_0) (r v1_0 v1_1) := ⟨v1_0, v1_1, rfl, rfl, rfl⟩
theorem rule2_intro (v2_0 v2_1 v2_2 : CM) : Rule 2 v2_0 (q v2_0 (q v2_1 (q v2_2 v2_0))) v2_2 := ⟨v2_0, v2_1, v2_2, rfl, rfl, rfl⟩
theorem rule3_intro (v3_0 v3_1 : CM) : Rule 3 v3_0 (q v3_0 (q v3_1 v3_0)) (q v3_0 (q v3_0 (q v3_1 v3_0))) := ⟨v3_0, v3_1, rfl, rfl, rfl⟩
theorem rule4_intro (v4_0 : CM) : Rule 4 v4_0 (q v4_0 v4_0) (q v4_0 (q v4_0 v4_0)) := ⟨v4_0, rfl, rfl, rfl⟩
theorem rule5_intro (v5_0 v5_1 v5_2 : CM) : Rule 5 (q v5_0 v5_1) (q (q v5_0 v5_1) v5_2) v5_0 := ⟨v5_0, v5_1, v5_2, rfl, rfl, rfl⟩
theorem rule6_intro (v6_0 v6_1 : CM) : Rule 6 v6_0 v6_1 (q v6_0 v6_1) := ⟨v6_0, v6_1, rfl, rfl, rfl⟩
inductive BlockedQ : CM → CM → Prop
  | r0 (v0_0 v0_1 v0_2 : CM) : BlockedQ v0_0 (p v0_0 (p (p v0_1 v0_2) (p v0_2 v0_0)))
  | r2 (v2_0 v2_1 v2_2 : CM) : BlockedQ v2_0 (q v2_0 (q v2_1 (q v2_2 v2_0)))
theorem blocked_q_shape {a b : CM} (h : BlockedQ a b) : (∃ v0_0 v0_1 v0_2 : CM, a = v0_0 ∧ b = (p v0_0 (p (p v0_1 v0_2) (p v0_2 v0_0)))) ∨ (∃ v2_0 v2_1 v2_2 : CM, a = v2_0 ∧ b = (q v2_0 (q v2_1 (q v2_2 v2_0)))) := by
  cases h with
  | r0 => exact Or.inl (⟨_, _, _, rfl, rfl⟩)
  | r2 => exact Or.inr (⟨_, _, _, rfl, rfl⟩)
inductive BlockedR : CM → CM → Prop
  | r0 (v0_0 v0_1 v0_2 : CM) : BlockedR v0_0 (p v0_0 (p (p v0_1 v0_2) (p v0_2 v0_0)))
  | r2 (v2_0 v2_1 v2_2 : CM) : BlockedR v2_0 (q v2_0 (q v2_1 (q v2_2 v2_0)))
  | r5 (v5_0 v5_1 v5_2 : CM) : BlockedR (q v5_0 v5_1) (q (q v5_0 v5_1) v5_2)
theorem blocked_r_shape {a b : CM} (h : BlockedR a b) : (∃ v0_0 v0_1 v0_2 : CM, a = v0_0 ∧ b = (p v0_0 (p (p v0_1 v0_2) (p v0_2 v0_0)))) ∨ (∃ v2_0 v2_1 v2_2 : CM, a = v2_0 ∧ b = (q v2_0 (q v2_1 (q v2_2 v2_0)))) ∨ (∃ v5_0 v5_1 v5_2 : CM, a = (q v5_0 v5_1) ∧ b = (q (q v5_0 v5_1) v5_2)) := by
  cases h with
  | r0 => exact Or.inl (⟨_, _, _, rfl, rfl⟩)
  | r2 => exact Or.inr (Or.inl (⟨_, _, _, rfl, rfl⟩))
  | r5 => exact Or.inr (Or.inr (⟨_, _, _, rfl, rfl⟩))
def NF : CM → Prop
  | e => True
  | k a => NF a
  | p a b => NF a ∧ NF b ∧ ¬ ∃ o, Code a b o
  | q a b => NF a ∧ NF b ∧ ¬ BlockedQ a b
  | r a b => NF a ∧ NF b ∧ ¬ BlockedR a b
theorem nf_p_no {a b : CM} (h : NF (p a b)) : ¬ ∃ o, Code a b o := h.2.2
theorem nf_p_left {a b : CM} (h : NF (p a b)) : NF a := h.1
theorem nf_p_right {a b : CM} (h : NF (p a b)) : NF b := h.2.1
theorem nf_q_left {a b : CM} (h : NF (q a b)) : NF a := h.1
theorem nf_q_right {a b : CM} (h : NF (q a b)) : NF b := h.2.1
theorem nf_q_no {a b : CM} (h : NF (q a b)) : ¬ BlockedQ a b := h.2.2
theorem nf_r_left {a b : CM} (h : NF (r a b)) : NF a := h.1
theorem nf_r_right {a b : CM} (h : NF (r a b)) : NF b := h.2.1
theorem nf_r_no {a b : CM} (h : NF (r a b)) : ¬ BlockedR a b := h.2.2
theorem nf_k {a : CM} (h : NF (k a)) : NF a := h
theorem explicit_code_transport {a b c d o : CM} (ha : a = c) (hb : b = d)
    (h : Code a b o) : Code c d o := by
  subst c
  subst d
  exact h
theorem eq_p_congr {a b c d : CM} (ha : a = c) (hb : b = d) : p a b = p c d := by
  cases ha
  cases hb
  rfl
theorem explicit_rule_transport {i : Nat} {a b c d o : CM}
    (ha : a = c) (hb : b = d) (h : Rule i a b o) : Rule i c d o := by
  subst c
  subst d
  exact h
theorem output_no_Q_3_0 (v3_0 v3_1 : CM) (ha : NF v3_0) (hb : NF (q v3_0 (q v3_1 v3_0))) (g0 : ¬ ∃ o, Rule 0 v3_0 (q v3_0 (q v3_1 v3_0)) o) (g1 : ¬ ∃ o, Rule 1 v3_0 (q v3_0 (q v3_1 v3_0)) o) (g2 : ¬ ∃ o, Rule 2 v3_0 (q v3_0 (q v3_1 v3_0)) o) :
    ¬ BlockedQ v3_0 (q v3_0 (q v3_1 v3_0)) := by
  intro hc
  rcases blocked_q_shape hc with ⟨nc3_0_0_v0_0, nc3_0_0_v0_1, nc3_0_0_v0_2, nc3_0_0_a, nc3_0_0_b⟩ | ⟨nc3_0_2_v2_0, nc3_0_2_v2_1, nc3_0_2_v2_2, nc3_0_2_a, nc3_0_2_b⟩
  · exfalso
    have impossible : (q nc3_0_0_v0_0 (q v3_1 nc3_0_0_v0_0)) = (p nc3_0_0_v0_0 (p (p nc3_0_0_v0_1 nc3_0_0_v0_2) (p nc3_0_0_v0_2 nc3_0_0_v0_0))) := Eq.trans (Eq.symm (eq_q_congr (nc3_0_0_a) (eq_q_congr (Eq.refl v3_1) (nc3_0_0_a)))) (nc3_0_0_b)
    cases impossible
  · exfalso
    have cyc : nc3_0_2_v2_0 = (q nc3_0_2_v2_2 nc3_0_2_v2_0) := @congrArg CM CM (q v3_1 nc3_0_2_v2_0) (q nc3_0_2_v2_1 (q nc3_0_2_v2_2 nc3_0_2_v2_0)) QR (@congrArg CM CM (q nc3_0_2_v2_0 (q v3_1 nc3_0_2_v2_0)) (q nc3_0_2_v2_0 (q nc3_0_2_v2_1 (q nc3_0_2_v2_2 nc3_0_2_v2_0))) QR (Eq.trans (Eq.symm (eq_q_congr (nc3_0_2_a) (eq_q_congr (Eq.refl v3_1) (nc3_0_2_a)))) (nc3_0_2_b)))
    have smaller : sz nc3_0_2_v2_0 < sz (q nc3_0_2_v2_2 nc3_0_2_v2_0) := sz_lt_q_right nc3_0_2_v2_2 nc3_0_2_v2_0
    exact (Nat.ne_of_lt smaller) (congrArg sz cyc)
theorem output_no_Q_4_1 (v4_0 : CM) (ha : NF v4_0) (hb : NF (q v4_0 v4_0)) (g0 : ¬ ∃ o, Rule 0 v4_0 (q v4_0 v4_0) o) (g1 : ¬ ∃ o, Rule 1 v4_0 (q v4_0 v4_0) o) (g2 : ¬ ∃ o, Rule 2 v4_0 (q v4_0 v4_0) o) (g3 : ¬ ∃ o, Rule 3 v4_0 (q v4_0 v4_0) o) :
    ¬ BlockedQ v4_0 (q v4_0 v4_0) := by
  intro hc
  rcases blocked_q_shape hc with ⟨nc4_1_0_v0_0, nc4_1_0_v0_1, nc4_1_0_v0_2, nc4_1_0_a, nc4_1_0_b⟩ | ⟨nc4_1_2_v2_0, nc4_1_2_v2_1, nc4_1_2_v2_2, nc4_1_2_a, nc4_1_2_b⟩
  · exfalso
    have impossible : (q nc4_1_0_v0_0 nc4_1_0_v0_0) = (p nc4_1_0_v0_0 (p (p nc4_1_0_v0_1 nc4_1_0_v0_2) (p nc4_1_0_v0_2 nc4_1_0_v0_0))) := Eq.trans (Eq.symm (eq_q_congr (nc4_1_0_a) (nc4_1_0_a))) (nc4_1_0_b)
    cases impossible
  · exfalso
