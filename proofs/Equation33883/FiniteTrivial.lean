@[reducible] def Equation2 (G : Type _) [Magma G] : Prop := ∀ (x y : G), x = y
@[reducible] def Equation12234 (G : Type _) [Magma G] : Prop := ∀ (x y z : G), x = y ◇ (((z ◇ x) ◇ y) ◇ (x ◇ y))

theorem finite_trivial (G : Type*) [Magma G] [Finite G] (h : Equation12234 G) : Equation2 G := by
  intro a b
  have ls (y : G) : Function.Surjective (fun t : G => y ◇ t) := by
    intro x
