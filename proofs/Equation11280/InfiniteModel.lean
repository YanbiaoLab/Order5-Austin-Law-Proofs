theorem source_holds (x v0 v1 : CM) :
    x = (eval (eval (eval v0 x) (eval (eval v0 v1) v0)) v0) := by
  let H0 := eval v0 x
  have e0a : v0 = v0 := by
    change v0 = v0
    rfl
  have e0b : x = x := by
    change x = x
    rfl
  have s0 : Step v0 x H0 := by
    rw [← e0a, ← e0b]
    exact eval_step v0 x
  let H1 := eval v0 v1
  have e1a : v0 = v0 := by
    change v0 = v0
    rfl
  have e1b : v1 = v1 := by
    change v1 = v1
    rfl
  have s1 : Step v0 v1 H1 := by
    rw [← e1a, ← e1b]
    exact eval_step v0 v1
  change x = (eval (eval H0 (eval H1 v0)) v0)
  have rawEq : (eval (eval H0 (eval H1 v0)) v0) = (eval (p H0 (p H1 v0)) v0) := by
    calc
      (eval (eval H0 (eval H1 v0)) v0) = (eval (eval H0 (p H1 v0)) v0) := congrArg (fun q => (eval (eval H0 q) v0)) (eval_raw (nr0 x v0 v1 H1 s1))
      _ = (eval (p H0 (p H1 v0)) v0) := congrArg (fun q => (eval q v0)) (eval_raw (nr1 x v0 v1 H0 H1 s0 s1))
  exact (eval_hit (Code.law x v0 v1 H0 H1 s0 s1)).symm.trans rawEq.symm
noncomputable instance instMagma2 : Magma CM where op a b := eval b a
end CM
