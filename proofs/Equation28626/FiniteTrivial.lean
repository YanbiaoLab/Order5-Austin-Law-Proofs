/- Every finite model of Equation17286 satisfies Equation2. The cyclic
incidence map is checked in Lean; the equational closure uses only explicit
instances, congrArg, transitivity, and symmetry. -/
import Mathlib.Data.Fintype.Card
import Mathlib.Data.Finite.Prod
import JudgeMagma.Magma

@[reducible] def Equation2 (G : Type _) [Magma G] : Prop := ∀ x y : G, x = y
@[reducible] def Equation17286 (G : Type _) [Magma G] : Prop :=
  ∀ x y z : G, x = (y ◇ x) ◇ (z ◇ (z ◇ (x ◇ z)))

namespace Equation17286FiniteIncidence

/-- Invert the cyclic map on triples whose first entry belongs to the
column indexed by their second entry. Both parts of the inverse are retained. -/
theorem column_completion (G : Type*) [Magma G] [Finite G]
    (h : Equation17286 G) (u x z : G) :
    let a := u ◇ (z ◇ (z ◇ (x ◇ z)))
    a ◇ z = x ◇ z ∧ ∃ w : G, w ◇ a = u := by
  let D := {t : G × G × G // ∃ w : G, w ◇ t.2.1 = t.1}
  let F : D → D := fun t =>
    ⟨(t.val.2.1 ◇ t.val.2.2, t.val.2.2, t.val.1), ⟨t.val.2.1, rfl⟩⟩
  have recover (t : D) :
      t.val.2.1 = t.val.1 ◇ (t.val.2.2 ◇ (t.val.2.2 ◇ (F t).val.1)) := by
    obtain ⟨w, hw⟩ := t.property
    have hh := h t.val.2.1 w t.val.2.2
    rw [hw] at hh
    exact hh
  have hi : Function.Injective F := by
    intro a b hab
    have hu : a.val.1 = b.val.1 := congrArg (fun t : D => t.val.2.2) hab
    have hz : a.val.2.2 = b.val.2.2 := congrArg (fun t : D => t.val.2.1) hab
    have hv : (F a).val.1 = (F b).val.1 := congrArg (fun t : D => t.val.1) hab
    have hy : a.val.2.1 = b.val.2.1 := by
      rw [recover a, recover b, hu, hz, hv]
    exact Subtype.ext (Prod.ext hu (Prod.ext hy hz))
  let target : D := ⟨(x ◇ z, z, u), ⟨x, rfl⟩⟩
  obtain ⟨t, ht⟩ := Finite.surjective_of_injective hi target
  have hu : t.val.1 = u := congrArg (fun t : D => t.val.2.2) ht
  have hz : t.val.2.2 = z := congrArg (fun t : D => t.val.2.1) ht
  have hv : (F t).val.1 = x ◇ z := congrArg (fun t : D => t.val.1) ht
  have hy : t.val.2.1 = u ◇ (z ◇ (z ◇ (x ◇ z))) := by
    rw [recover t, hu, hz, hv]
  constructor
  · change t.val.2.1 ◇ t.val.2.2 = x ◇ z at hv
    rwa [hy, hz] at hv
  · obtain ⟨w, hw⟩ := t.property
    rw [hy, hu] at hw
    exact ⟨w, hw⟩

theorem column_image_inverse (G : Type*) [Magma G] [Finite G]
    (h : Equation17286 G) (u x z : G) :
    (u ◇ (z ◇ (z ◇ (x ◇ z)))) ◇ z = x ◇ z :=
  (column_completion G h u x z).1

/-- The row identity on the images supplied by the source equation. -/
theorem restricted_row_identity (G : Type*) [Magma G] [Finite G]
    (h : Equation17286 G) (u x z t : G) :
    let a := u ◇ (z ◇ (z ◇ (x ◇ z)))
    u ◇ (t ◇ (t ◇ (a ◇ t))) = a := by
  obtain ⟨w, hw⟩ := (column_completion G h u x z).2
  have hh := (h (u ◇ (z ◇ (z ◇ (x ◇ z)))) w t).symm
  rwa [hw] at hh

#print axioms column_completion
#print axioms column_image_inverse
#print axioms restricted_row_identity

theorem finite_trivial (G : Type*) [Magma G] [Finite G]
    (h : Equation17286 G) : Equation2 G := by
  intro a b
  let p (x z : G) : G := z ◇ (z ◇ (x ◇ z))
  have p2 (x y : G) : (x ◇ (x ◇ (y ◇ x))) = (p y x) := by
    exact rfl
  have p3 (x y z : G) : ((x ◇ y) ◇ (p y z)) = y := by
    exact (h y x z).symm
  have p4 (x y z : G) : ((x ◇ (p y z)) ◇ z) = (y ◇ z) := by
    exact column_image_inverse G h x y z
  have p5 (u x y z : G) : (x ◇ (p (x ◇ (p y z)) u)) = (x ◇ (p y z)) := by
    exact restricted_row_identity G h x y z u
  have p7 (x y : G) : ((x ◇ (y ◇ x)) ◇ ((x ◇ (y ◇ x)) ◇ (p y x))) = (p x (x ◇ (y ◇ x))) := by
    exact (((congrArg (fun _t : G => ((x ◇ (y ◇ x)) ◇ ((x ◇ (y ◇ x)) ◇ _t))) ((p2 x y)))).symm).trans ((p2 (x ◇ (y ◇ x)) x))
  have p8 (x y z : G) : (p (x ◇ y) (p y z)) = ((p y z) ◇ ((p y z) ◇ y)) := by
    exact ((((congrArg (fun _t : G => ((p y z) ◇ ((p y z) ◇ _t))) ((p3 x y z)))).symm).trans ((p2 (p y z) (x ◇ y)))).symm
  have p9 (x y z : G) : ((p x y) ◇ (p (y ◇ (x ◇ y)) z)) = (y ◇ (x ◇ y)) := by
    exact (((congrArg (fun _t : G => (_t ◇ (p (y ◇ (x ◇ y)) z))) ((p2 y x)))).symm).trans ((p3 y (y ◇ (x ◇ y)) z))
  have p10 (x y z : G) : (x ◇ (p (p x y) z)) = (p x y) := by
    exact (((congrArg (fun _t : G => (_t ◇ (p (p x y) z))) ((p3 a x y)))).symm).trans ((p3 (a ◇ x) (p x y) z))
  have p11 (x y z : G) : (p (x ◇ (p y z)) z) = (p y z) := by
    exact ((((p2 z y)).symm).trans ((((congrArg (fun _t : G => (z ◇ (z ◇ _t))) ((p4 x y z)))).symm).trans ((p2 z (x ◇ (p y z)))))).symm
  have p12 (u x y z : G) : ((p (x ◇ (p y z)) u) ◇ ((p (x ◇ (p y z)) u) ◇ (x ◇ (p y z)))) = (p x (p (x ◇ (p y z)) u)) := by
    exact (((congrArg (fun _t : G => ((p (x ◇ (p y z)) u) ◇ ((p (x ◇ (p y z)) u) ◇ _t))) ((p5 u x y z)))).symm).trans ((p2 (p (x ◇ (p y z)) u) x))
  have p13 (u w x y z : G) : ((x ◇ (p y (p z u))) ◇ (p (y ◇ (p z u)) w)) = (y ◇ (p z u)) := by
    exact ((((congrArg (fun _t : G => ((x ◇ (p y (p z u))) ◇ (p _t w))) ((p4 x y (p z u))))).symm).trans ((p5 w (x ◇ (p y (p z u))) z u))).trans ((p4 x y (p z u)))
  have p16 (x y z : G) : (((p x y) ◇ x) ◇ (((p x y) ◇ x) ◇ (p (z ◇ x) (p x y)))) = (p (p x y) ((p x y) ◇ x)) := by
    exact ((((congrArg (fun _t : G => (((p x y) ◇ x) ◇ (((p x y) ◇ _t) ◇ (p (z ◇ x) (p x y))))) ((p3 z x y)))).symm).trans ((((congrArg (fun _t : G => (((p x y) ◇ _t) ◇ (((p x y) ◇ ((z ◇ x) ◇ (p x y))) ◇ (p (z ◇ x) (p x y))))) ((p3 z x y)))).symm).trans ((p7 (p x y) (z ◇ x))))).trans ((congrArg (fun _t : G => (p (p x y) ((p x y) ◇ _t))) ((p3 z x y))))
  have p19 (x y z : G) : ((p (p x y) z) ◇ ((p (p x y) z) ◇ (p x y))) = (p x (p (p x y) z)) := by
    exact (((congrArg (fun _t : G => ((p (p x y) z) ◇ ((p (p x y) z) ◇ _t))) ((p10 x y z)))).symm).trans ((p2 (p (p x y) z) x))
  have p21 (u x y z : G) : ((x ◇ (y ◇ (p z u))) ◇ (p z u)) = (y ◇ (p z u)) := by
    exact (((congrArg (fun _t : G => ((x ◇ (y ◇ (p z u))) ◇ _t)) ((p11 y z u)))).symm).trans ((p3 x (y ◇ (p z u)) u))
  have p22 (x y z : G) : ((p (x ◇ (y ◇ x)) z) ◇ ((p (x ◇ (y ◇ x)) z) ◇ (x ◇ (y ◇ x)))) = (p (p y x) (p (x ◇ (y ◇ x)) z)) := by
    exact ((((congrArg (fun _t : G => (p _t (p (x ◇ (y ◇ x)) z))) ((p2 x y)))).symm).trans ((p8 x (x ◇ (y ◇ x)) z))).symm
  have p23 (u x y z : G) : ((x ◇ (y ◇ z)) ◇ ((p z u) ◇ ((p z u) ◇ z))) = (y ◇ z) := by
    exact (((congrArg (fun _t : G => ((x ◇ (y ◇ z)) ◇ _t)) ((p8 y z u)))).symm).trans ((p3 x (y ◇ z) (p z u)))
  have p24 (u x y z : G) : ((p (x ◇ y) (p y z)) ◇ (p ((p y z) ◇ y) u)) = ((p y z) ◇ y) := by
    exact (((congrArg (fun _t : G => (_t ◇ (p ((p y z) ◇ y) u))) (((p8 x y z)).symm))).symm).trans ((p3 (p y z) ((p y z) ◇ y) u))
  have p25 (x y z : G) : ((x ◇ ((p y z) ◇ ((p y z) ◇ y))) ◇ (p y z)) = y := by
    exact ((((congrArg (fun _t : G => ((x ◇ _t) ◇ (p y z))) ((p8 a y z)))).symm).trans ((p4 x (a ◇ y) (p y z)))).trans ((p3 a y z))
  have p27 (u x y z : G) : (x ◇ (p y (p (p y z) u))) = (x ◇ (p y z)) := by
    exact (((congrArg (fun _t : G => (x ◇ _t)) ((p19 y z u)))).symm).trans ((((congrArg (fun _t : G => (x ◇ _t)) ((p8 x (p y z) u)))).symm).trans ((p5 (p (p y z) u) x y z)))
  have p33 (u x y z : G) : ((x ◇ y) ◇ (p ((p y z) ◇ ((p y z) ◇ y)) u)) = (p (x ◇ y) (p y z)) := by
    exact (((congrArg (fun _t : G => ((x ◇ y) ◇ (p _t u))) ((p8 x y z)))).symm).trans ((p10 (x ◇ y) (p y z) u))
  have p35 (u x y z : G) : (p (x ◇ (y ◇ (p z u))) (p z u)) = (p y (p z u)) := by
    exact ((((((congrArg (fun _t : G => (p (x ◇ (y ◇ (p z u))) _t)) ((p11 y z u)))).symm).trans ((p8 x (y ◇ (p z u)) u))).trans ((congrArg (fun _t : G => (_t ◇ ((p (y ◇ (p z u)) u) ◇ (y ◇ (p z u))))) ((p11 y z u))))).trans ((congrArg (fun _t : G => ((p z u) ◇ (_t ◇ (y ◇ (p z u))))) ((p11 y z u))))).trans ((p2 (p z u) y))
  have p38 (u x y z : G) : (p (x ◇ (y ◇ z)) (p (y ◇ z) (p z u))) = ((p (y ◇ z) (p z u)) ◇ (((p z u) ◇ ((p z u) ◇ z)) ◇ (y ◇ z))) := by
    exact ((p8 x (y ◇ z) (p z u))).trans ((congrArg (fun _t : G => ((p (y ◇ z) (p z u)) ◇ (_t ◇ (y ◇ z)))) ((p8 y z u))))
  have p40 (u x y z : G) : (p (x ◇ y) (p y z)) = (p (u ◇ y) (p y z)) := by
    exact ((p8 x y z)).trans (((p8 u y z)).symm)
  have p42 (u x y z : G) : ((p x (p (p x y) z)) ◇ ((p x (p (p x y) z)) ◇ (u ◇ (p x y)))) = (p u (p x (p (p x y) z))) := by
    exact (((congrArg (fun _t : G => ((p x (p (p x y) z)) ◇ ((p x (p (p x y) z)) ◇ _t))) ((p27 z u x y)))).symm).trans ((p2 (p x (p (p x y) z)) u))
  have p43 (u w x y z : G) : ((x ◇ (p y z)) ◇ (p (p y (p (p y z) u)) w)) = (p y (p (p y z) u)) := by
    exact (((congrArg (fun _t : G => (_t ◇ (p (p y (p (p y z) u)) w))) ((p27 u x y z)))).symm).trans ((p3 x (p y (p (p y z) u)) w))
  have p46 (u x y z : G) : (p (x ◇ (p y z)) (p (p y z) u)) = (p y (p (p y z) u)) := by
    exact (((congrArg (fun _t : G => (p _t (p (p y z) u))) ((p27 u x y z)))).symm).trans ((p11 x y (p (p y z) u)))
  have p48 (u w x y z : G) : (x ◇ (p (y ◇ z) (p ((p z u) ◇ ((p z u) ◇ z)) w))) = (x ◇ (p (y ◇ z) (p z u))) := by
    exact (((congrArg (fun _t : G => (x ◇ (p (y ◇ z) (p _t w)))) ((p8 y z u)))).symm).trans ((p27 w x (y ◇ z) (p z u)))
  have p55 (u w x y z : G) : ((p x (p y (p (p y z) u))) ◇ (p ((p y (p (p y z) u)) ◇ (x ◇ (p y z))) w)) = ((p y (p (p y z) u)) ◇ (x ◇ (p y z))) := by
    exact ((((congrArg (fun _t : G => ((p x (p y (p (p y z) u))) ◇ (p ((p y (p (p y z) u)) ◇ _t) w))) ((p27 u x y z)))).symm).trans ((p9 x (p y (p (p y z) u)) w))).trans ((congrArg (fun _t : G => ((p y (p (p y z) u)) ◇ _t)) ((p27 u x y z))))
  have p58 (u w x y z : G) : ((x ◇ (y ◇ z)) ◇ (p (u ◇ z) (p z w))) = (y ◇ z) := by
    exact (((congrArg (fun _t : G => ((x ◇ (y ◇ z)) ◇ _t)) ((p40 u y z w)))).symm).trans ((p3 x (y ◇ z) (p z w)))
  have p61 (u w x y z : G) : ((x ◇ y) ◇ (p (p (z ◇ y) (p y u)) w)) = (p (x ◇ y) (p y u)) := by
    exact (((congrArg (fun _t : G => ((x ◇ y) ◇ (p _t w))) ((p40 z x y u)))).symm).trans ((p10 (x ◇ y) (p y u) w))
  have p69 (u x y z : G) : ((p x y) ◇ (p (z ◇ (x ◇ y)) (p (x ◇ y) u))) = (y ◇ (x ◇ y)) := by
    exact (((congrArg (fun _t : G => ((p x y) ◇ _t)) ((p40 z y (x ◇ y) u)))).symm).trans ((p9 x y (p (x ◇ y) u)))
  have p74 (x y z : G) : ((p x (p (p x y) z)) ◇ (p x y)) = ((p (p x y) z) ◇ (p x y)) := by
    exact (((congrArg (fun _t : G => (_t ◇ (p x y))) ((p46 z a x y)))).symm).trans ((((congrArg (fun _t : G => (_t ◇ (p x y))) (((p8 a (p x y) z)).symm))).symm).trans ((p21 y (p (p x y) z) (p (p x y) z) x)))
  have p77 (u x y z : G) : ((x ◇ ((p y z) ◇ ((p y z) ◇ y))) ◇ (p y u)) = y := by
    exact ((((congrArg (fun _t : G => ((x ◇ ((p y z) ◇ ((p y z) ◇ y))) ◇ (p _t u))) ((p25 x y z)))).symm).trans ((p5 u (x ◇ ((p y z) ◇ ((p y z) ◇ y))) y z))).trans ((p25 x y z))
  have p85 (u w x y z : G) : ((x ◇ (y ◇ (z ◇ (p u w)))) ◇ (p z (p u w))) = (y ◇ (z ◇ (p u w))) := by
    exact (((congrArg (fun _t : G => ((x ◇ (y ◇ (z ◇ (p u w)))) ◇ _t)) ((p35 w y z u)))).symm).trans ((p3 x (y ◇ (z ◇ (p u w))) (p u w)))
  have p86 (u w x y z : G) : (p (x ◇ (y ◇ (p z u))) (p (y ◇ (p z u)) w)) = (p y (p (y ◇ (p z u)) w)) := by
    exact (((congrArg (fun _t : G => (p (x ◇ _t) (p (y ◇ (p z u)) w))) ((p5 w y z u)))).symm).trans ((p35 w x y (y ◇ (p z u))))
  have p87 (x y : G) : (p (p x (x ◇ (y ◇ x))) (p y x)) = (p (x ◇ (y ◇ x)) (p y x)) := by
    exact (((congrArg (fun _t : G => (p _t (p y x))) ((p7 x y)))).symm).trans ((p35 x (x ◇ (y ◇ x)) (x ◇ (y ◇ x)) y))
  have p88 (u w x y z : G) : ((x ◇ (y ◇ (p z u))) ◇ (p (p y (p z u)) w)) = (p y (p z u)) := by
    exact ((((congrArg (fun _t : G => ((x ◇ (y ◇ (p z u))) ◇ (p _t w))) ((p35 u x y z)))).symm).trans ((p10 (x ◇ (y ◇ (p z u))) (p z u) w))).trans ((p35 u x y z))
  have p92 (u x y z : G) : (p x (p (y ◇ z) (p z u))) = (p x ((p z u) ◇ ((p z u) ◇ z))) := by
    exact (((p35 (p z u) a x (y ◇ z))).symm).trans (((p35 (p z u) a x (y ◇ z))).trans ((congrArg (fun _t : G => (p x _t)) ((p8 y z u)))))
  have p93 (x y z : G) : (p (p x (p (p x y) z)) (p x y)) = (p (p (p x y) z) (p x y)) := by
    exact (((congrArg (fun _t : G => (p _t (p x y))) ((p46 z a x y)))).symm).trans ((((congrArg (fun _t : G => (p _t (p x y))) (((p8 a (p x y) z)).symm))).symm).trans ((p35 y (p (p x y) z) (p (p x y) z) x)))
  have p95 (u w x y z : G) : (p (x ◇ (y ◇ (p z u))) (p z (p (p z u) w))) = (p y (p z (p (p z u) w))) := by
    exact (((congrArg (fun _t : G => (p (x ◇ _t) (p z (p (p z u) w)))) ((p27 w y z u)))).symm).trans ((p35 (p (p z u) w) x y z))
  have p96 (x y z : G) : ((p x (p y z)) ◇ (p x (p y z))) = ((p y z) ◇ (x ◇ (p y z))) := by
    exact (((congrArg (fun _t : G => ((p x (p y z)) ◇ _t)) ((p35 z (p y z) x y)))).symm).trans ((p9 x (p y z) (p y z)))
  have p98 (u v5 w x y z : G) : (p (x ◇ (y ◇ (p (z ◇ u) (p u w)))) (p (v5 ◇ u) (p u w))) = (p y (p (v5 ◇ u) (p u w))) := by
    exact (((congrArg (fun _t : G => (p (x ◇ (y ◇ _t)) (p (v5 ◇ u) (p u w)))) ((p40 z v5 u w)))).symm).trans ((p35 (p u w) x y (v5 ◇ u)))
  have p99 (u w x y z : G) : (p x (p (y ◇ z) (p z u))) = (p x (p (w ◇ z) (p z u))) := by
    exact (((p98 z y u a x w)).symm).trans ((((congrArg (fun _t : G => (p (a ◇ (x ◇ (p (w ◇ z) (p z u)))) _t)) ((p40 y w z u)))).symm).trans ((p35 (p z u) a x (w ◇ z))))
  have p117 (u w x y z : G) : (p (x ◇ y) (p (p (z ◇ y) (p y u)) w)) = (p (z ◇ y) (p (p (z ◇ y) (p y u)) w)) := by
    exact ((((congrArg (fun _t : G => (p _t (p (p (z ◇ y) (p y u)) w))) ((p58 z u a x y)))).symm).trans ((p8 (a ◇ (x ◇ y)) (p (z ◇ y) (p y u)) w))).trans ((p19 (z ◇ y) (p y u) w))
  have p135 (u w x y z : G) : ((x ◇ (p (y ◇ z) (p z u))) ◇ (p z w)) = z := by
    exact (((congrArg (fun _t : G => ((x ◇ _t) ◇ (p z w))) (((p8 y z u)).symm))).symm).trans ((p77 w x z u))
  have p141 (u w x y z : G) : (p (x ◇ ((p y z) ◇ ((p y z) ◇ y))) (p y u)) = (p (w ◇ y) (p y u)) := by
    exact ((((congrArg (fun _t : G => (p (w ◇ _t) (p y u))) ((p77 u x y z)))).symm).trans ((p35 u w (x ◇ ((p y z) ◇ ((p y z) ◇ y))) y))).symm
  have p145 (u w x y z : G) : (p (x ◇ (p (y ◇ z) (p z u))) (p z w)) = ((p z w) ◇ ((p z w) ◇ z)) := by
    exact ((((congrArg (fun _t : G => ((p z w) ◇ ((p z w) ◇ _t))) ((p135 u w x y z)))).symm).trans ((p2 (p z w) (x ◇ (p (y ◇ z) (p z u)))))).symm
  have p155 (u v5 w x y z : G) : (p (x ◇ (p (y ◇ z) (p z u))) (p z w)) = (p (v5 ◇ z) (p z w)) := by
    exact ((((congrArg (fun _t : G => (p (v5 ◇ _t) (p z w))) ((p135 u w x y z)))).symm).trans ((p35 w v5 (x ◇ (p (y ◇ z) (p z u))) z))).symm
  have p166 (u x y z : G) : ((p (x ◇ y) (p y z)) ◇ ((p y u) ◇ ((p y u) ◇ y))) = ((p y z) ◇ y) := by
    exact (((congrArg (fun _t : G => (_t ◇ ((p y u) ◇ ((p y u) ◇ y)))) (((p8 x y z)).symm))).symm).trans ((p23 u (p y z) (p y z) y))
  have p184 (u v5 v6 w x y z : G) : ((x ◇ (p (y ◇ (p (z ◇ u) (p u w))) (p u v5))) ◇ (p u v6)) = u := by
